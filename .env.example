# NeuroSleepNet — Environment Variables
# Copy to .env and fill in all required values before running.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────
NSN_API_KEY_SECRET=your-api-key-secret-here
NSN_JWT_SECRET=your-jwt-secret-here-min-32-chars
NSN_ENVIRONMENT=development          # development | production

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nsn:nsn@localhost:5433/neurosleepnet
POSTGRES_DB=neurosleepnet
POSTGRES_USER=nsn
POSTGRES_PASSWORD=nsn
NSN_VECTOR_DIM=384                   # Must match embed model output dimension

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ─────────────────────────────────────────────────────────────────────────────
# Embedding
# ─────────────────────────────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://localhost:8001
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ─────────────────────────────────────────────────────────────────────────────
# Safety & Data
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED in production. AES-256 master key for per-tenant encryption.
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
NSN_ENCRYPTION_MASTER_KEY=

# Comma-separated list of allowed CORS origins
# Dev default: http://localhost:3000,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

NSN_PII_DETECTION_ENABLED=true      # Default ON. Requires explicit false to disable.
NSN_MAX_MEMORY_CONTENT_TOKENS=8192
NSN_DEFAULT_MIN_MEMORIES=3
NSN_DEFAULT_TTL_DAYS=               # Empty = no default TTL

# ─────────────────────────────────────────────────────────────────────────────
# Sleep Engine
# ─────────────────────────────────────────────────────────────────────────────
NSN_SLEEP_SCHEDULE=0 3 * * *        # Cron — 3am UTC daily
NSN_SLEEP_FALLBACK_HOURS=48         # Mini-consolidation trigger threshold

# ─────────────────────────────────────────────────────────────────────────────
# Webhooks
# ─────────────────────────────────────────────────────────────────────────────
NSN_WEBHOOK_TIMEOUT_SECONDS=10
NSN_WEBHOOK_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────────────────
# GitHub OAuth
# ─────────────────────────────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → "New OAuth App"
# 2. Set "Homepage URL"              → http://localhost:3000
# 3. Set "Authorization callback URL" → http://localhost:8080/api/v1/auth/callback
#    (use your real domain in production, e.g. https://nsn.ai/api/v1/auth/callback)
# 4. Copy the Client ID and generate a Client Secret below:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the backend redirects after successful login (must match your frontend origin)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
NSN_BENCHMARK_ENABLED=true
NSN_TELEMETRY_ENABLED=false         # Never default true. Opt-in only.
